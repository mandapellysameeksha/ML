x = 5              # an integer (whole number)
y = 3.14           # a float (decimal number)
name = "CGPA"      # a string (text) - always in quotes
is_placed = True   # a boolean (True/False)

# type() tells you what kind of value a variable holds.
# You will use this constantly to sanity-check data you loaded from a CSV.
print(x, type(x))
print(y, type(y))
print(name, type(name))
print(is_placed, type(is_placed))
a = 7
b = 2
print("a + b =", a + b)     # addition
print("a - b =", a - b)     # subtraction
print("a * b =", a * b)     # multiplication
print("a / b =", a / b)     # division (always gives a float)
print("a ** 2 =", a ** 2)   # exponent (a squared) - used in Mean Squared Error formulas

# --- COMPARISON OPERATORS ---
cgpa = 8.4
print("cgpa == 8.4 :", cgpa == 8.4)   # equality check (note: double ==, not =)
print("cgpa > 8    :", cgpa > 8)      # greater than
print("cgpa < 6    :", cgpa < 6)      # less than

# --- LOGICAL OPERATORS: and / or / not ---
attendance = 85
placed = (cgpa > 8) and (attendance > 80)   # both conditions must be true
print("placed :", placed)
model_name = "Logistic Regression"
accuracy = 0.87345

# Old, clunky way (avoid this):
print("Accuracy of " + model_name + " is " + str(accuracy))

# f-string way (use this):
print(f"Accuracy of {model_name} is {accuracy}")

# ':.3f' inside the braces rounds a float to 3 decimal places -
# you will use this in almost every experiment to print clean metrics.
print(f"Accuracy of {model_name} is {accuracy:.3f}")
features = ["CGPA", "AptitudeTestScore", "CodingTestScore", "MockInterviewScore"]

print(features)          # the whole list
print(features[0])       # FIRST item - Python counts from 0, not 1
print(features[1])       # SECOND item
print(features[-1])      # LAST item - negative index counts from the end
print(len(features))     # how many items are in the list

# Slicing: features[start:end] gives you a sub-list (end is NOT included)
print(features[0:2])     # first two items

